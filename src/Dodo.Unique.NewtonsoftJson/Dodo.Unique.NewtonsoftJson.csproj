<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Dodo.Unique.NewtonsoftJson</PackageId>
        <Description>Newtonsoft.Json addon for Dodo.Unique: a JsonConverter&lt;string&gt; that routes deserialized strings through a UniqueStringPool.</Description>
        <PackageTags>unique;string;stringpool;pool;pooling;intern;interning;canonicalization;deduplication;memory;json;newtonsoft;json.net</PackageTags>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <EnablePackageValidation>true</EnablePackageValidation>
        <PackageValidationBaselineVersion>1.1.0</PackageValidationBaselineVersion>
    </PropertyGroup>
    <ItemGroup>
        <None Include="../../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\Dodo.Unique\Dodo.Unique.csproj" />
        <PackageReference Include="Newtonsoft.Json" />
        <PackageReference Include="MinVer" PrivateAssets="all" />
    </ItemGroup>
</Project>
