<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <PackageId>Dodo.Unique</PackageId>
        <PackageVersion>1.0.0</PackageVersion>
        <Description>Time-bounded string canonicalization (one canonical instance per equal value) with a System.Text.Json converter. Inspired by Go's `unique` package.</Description>
        <PackageTags>string;canonicalization;interning;deduplication;json;system.text.json</PackageTags>
        <IsPackable>true</IsPackable>
        <IncludeSymbols>true</IncludeSymbols>
        <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    </PropertyGroup>
</Project>
